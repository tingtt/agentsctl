#!/usr/bin/env python3
import json, os, subprocess, sys, termios, tty
from pathlib import Path

root = Path(os.environ["AGENTSCTL_FAKE_DIR"])
path = root / "claude.json"

def load():
    if not path.exists():
        return [{"id":"claude-ready","name":"fake-claude","summary":"Ready","cwd":os.getcwd(),"updatedAt":1,"status":"idle","state":"done"}]
    return json.loads(path.read_text())

def save(rows):
    path.write_text(json.dumps(rows))

def arg_value(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            return args[i + 1]
    return None

def probe_session(session_id, settings_flag):
    # Stands in for a real, actively-rendering interactive `claude`
    # session for usage_probe_unix.go's Probe: it goes raw, and once it
    # sees a full line (terminated by '\r', matching Probe.refresh's own
    # prompt submission), it invokes the statusLine command named in
    # --settings with a canned rate_limits payload piped to its stdin --
    # the same shape Claude Code itself invokes a statusLine command with
    # after a session's first API response. A ratelimits.json fixture under
    # AGENTSCTL_FAKE_DIR controls the payload; its absence means "no
    # rate_limits yet" (payload has none), matching a pre-first-response
    # session.
    #
    # tty.setraw(0) must run before ANY other I/O in this process
    # (matching the "attach" branch below), not just before this
    # function's own load()/save() calls: Python's tty.setraw uses
    # termios' TCSAFLUSH, which discards any input the kernel already
    # queued before it runs. Go's startClaudeAttachRaw puts the pty's
    # slave into raw mode before this process even starts specifically so
    # a caller's write is never lost regardless of this process's own
    # startup delay (see its doc comment) -- but that guarantee is only
    # real if this script's own redundant setraw call (a harmless no-op
    # the way startClaudeAttachRaw intends it) doesn't itself flush away
    # input that arrived during slower startup work, including Python's
    # own interpreter/import startup and any file I/O performed before
    # this call. This is why settings_flag's copy (below) waits until
    # after setraw, unlike the other, non-interactive branches' dispatch.
    old = termios.tcgetattr(0)
    tty.setraw(0)

    if settings_flag:
        # The real settings path passed on argv can vary per test run;
        # record it once so run_statusline (which has no argv of its own)
        # can find it regardless of the actual --settings path used.
        (root / "probe-settings.json").write_text(Path(settings_flag).read_text())
    rows = load()
    rows = [r for r in rows if r["id"] != session_id]
    rows.append({"id": session_id, "name": "agentsctl usage probe", "summary": "", "cwd": os.getcwd(), "updatedAt": 1, "status": "idle", "state": "done"})
    save(rows)

    buf = b""
    try:
        os.write(1, b"FAKE CLAUDE PROBE ATTACHED\r\n")
        while True:
            b = os.read(0, 1)
            if not b or b == b"\x1a":
                break
            buf += b
            if b in (b"\r", b"\n"):
                run_statusline()
                buf = b""
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, old)

def run_statusline():
    settings_path = root / "probe-settings.json"
    if not settings_path.exists():
        return
    settings = json.loads(settings_path.read_text())
    command = settings.get("statusLine", {}).get("command")
    if not command:
        return
    ratelimits_path = root / "ratelimits.json"
    payload = {"session_id": "probe"}
    if ratelimits_path.exists():
        payload["rate_limits"] = json.loads(ratelimits_path.read_text())
    subprocess.run(command, shell=True, input=json.dumps(payload).encode(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

args = sys.argv[1:]

if args[:1] == ["agents"]:
    print(json.dumps(load()))
elif args[:1] == ["--bg"]:
    rows = load(); sid = "claude-new"
    rows = [r for r in rows if r["id"] != sid]
    rows.append({"id":sid,"name":"fake-claude-new","summary":args[1],"cwd":os.getcwd(),"updatedAt":2,"status":"busy","state":"working"})
    save(rows); print(sid)
elif args[:1] == ["stop"]:
    rows = load()
    for row in rows:
        if row["id"] == args[1]: row["status"] = "idle"; row["state"] = "stopped"
    save(rows)
elif args[:1] == ["attach"]:
    old = termios.tcgetattr(0); tty.setraw(0)
    try:
        os.write(1, b"FAKE CLAUDE ATTACHED\r\n")
        while True:
            b = os.read(0, 1)
            if not b or b == b"\x1a": break
            os.write(1, b)
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, old)
elif "--session-id" in args or "--resume" in args:
    session_id = arg_value(args, "--session-id") or arg_value(args, "--resume")
    probe_session(session_id, arg_value(args, "--settings"))
else:
    sys.exit(2)
