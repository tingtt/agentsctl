#!/usr/bin/env python3
import json, os, signal, subprocess, sys, termios, tty
from pathlib import Path

root = Path(os.environ["AGENTSCTL_FAKE_DIR"])
path = root / "claude.json"

def load():
    if not path.exists():
        return [{"id":"claude-ready","name":"fake-claude","summary":"Ready","cwd":os.getcwd(),"updatedAt":1,"status":"idle","state":"done"}]
    return json.loads(path.read_text())

def save(rows):
    path.write_text(json.dumps(rows))

def arg_value(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            return args[i + 1]
    return None

# TRUST_DIALOG_ACCEPT mirrors usageProbeTrustDialogAccept
# (usage_probe_unix.go): Down arrow then Enter, the exact bytes real
# Claude Code's workspace-trust dialog needs to select "Yes, I trust this
# folder" over its own default-selected "No, exit".
TRUST_DIALOG_ACCEPT = b"\x1b[B\r"

def probe_session(session_id, settings_flag):
    # Stands in for a real, actively-rendering interactive `claude`
    # session for usage_probe_unix.go's Probe: it goes raw, and once it
    # sees a full line (terminated by '\r', matching Probe.refreshOnce's own
    # prompt submission), it invokes the statusLine command named in
    # --settings with a canned rate_limits payload piped to its stdin --
    # the same shape Claude Code itself invokes a statusLine command with
    # after a session's first API response. A ratelimits.json fixture under
    # AGENTSCTL_FAKE_DIR controls the payload; its absence means "no
    # rate_limits yet" (payload has none), matching a pre-first-response
    # session.
    #
    # probe_invocations.log records one line per invocation of this
    # function, regardless of outcome -- usage_probe_unix_test.go's bounded-
    # retry tests (Issue #19's session-conflict recovery) count these to
    # prove a recovery retry happens at most once, never a loop.
    with (root / "probe_invocations.log").open("a") as f:
        f.write(session_id + "\n")
    #
    # tty.setraw(0) must run before ANY other I/O in this process
    # (matching the "attach" branch below), not just before this
    # function's own load()/save() calls: Python's tty.setraw uses
    # termios' TCSAFLUSH, which discards any input the kernel already
    # queued before it runs. Go's startClaudeAttachRaw puts the pty's
    # slave into raw mode before this process even starts specifically so
    # a caller's write is never lost regardless of this process's own
    # startup delay (see its doc comment) -- but that guarantee is only
    # real if this script's own redundant setraw call (a harmless no-op
    # the way startClaudeAttachRaw intends it) doesn't itself flush away
    # input that arrived during slower startup work, including Python's
    # own interpreter/import startup and any file I/O performed before
    # this call. This is why settings_flag's copy (below) waits until
    # after setraw, unlike the other, non-interactive branches' dispatch.
    old = termios.tcgetattr(0)
    tty.setraw(0)

    # Real Claude Code (verified against the installed CLI): a plain
    # interactive session ignores SIGTERM (does not exit), and treats a
    # literal Ctrl+Z byte on stdin as an ordinary job-control suspend
    # request rather than an exit -- only SIGINT actually ends the
    # process. Modeled here so a test exercising detachProbeSession's
    # SIGINT-then-SIGKILL escalation against this fake actually proves
    # something, instead of trivially "working" against a fake that exits
    # on anything.
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

    if settings_flag:
        # The real settings path passed on argv can vary per test run;
        # record it once so run_statusline (which has no argv of its own)
        # can find it regardless of the actual --settings path used.
        (root / "probe-settings.json").write_text(Path(settings_flag).read_text())

    # session_conflict.txt (usage_probe_unix_test.go's session-conflict
    # fixture) stands in for the real CLI rejecting this --session-id as
    # already in use elsewhere: verified against the installed CLI
    # (2.1.263) via a live reproduction of Issue #19's "?% never updates"
    # symptom that a rejected session ID prints an error and exits
    # immediately, well before any trust dialog or chat input -- see
    # probeSessionConflict's doc comment. Checked before anything else in
    # this function that would otherwise consume stdin.
    #
    # session_conflict_session_ids.txt, if present alongside it, scopes
    # the rejection to only the listed session IDs (one per line) --
    # modeling a specific ID being rejected (Issue #19's real, live
    # observation) rather than every ID this fake CLI is ever invoked
    # with, so a test can drive a rejected-then-rotated identity through
    # ONE Usage() call and observe the rotated ID succeed. Its absence
    # means unconditional rejection, for tests that want every attempt
    # (including a rotation retry) to keep failing.
    conflict_path = root / "session_conflict.txt"
    if conflict_path.exists():
        ids_path = root / "session_conflict_session_ids.txt"
        reject = True
        if ids_path.exists():
            reject = session_id in ids_path.read_text().splitlines()
        if reject:
            os.write(1, conflict_path.read_bytes())
            termios.tcsetattr(0, termios.TCSADRAIN, old)
            sys.exit(1)

    rows = load()
    rows = [r for r in rows if r["id"] != session_id]
    rows.append({"id": session_id, "name": "agentsctl usage probe", "summary": "", "cwd": os.getcwd(), "updatedAt": 1, "status": "idle", "state": "done"})
    save(rows)

    # Real Claude Code (verified against the installed CLI): a brand-new,
    # never-before-seen directory shows a workspace-trust confirmation
    # dialog before any chat input is accepted, defaulting to "No, exit"
    # -- so any input that isn't exactly TRUST_DIALOG_ACCEPT (e.g. a
    # prompt sent without first answering it, reproducing this package's
    # original bug) selects that default and exits immediately, never
    # reaching chat input or invoking statusLine at all. Once accepted,
    # trust is remembered per-directory by Claude Code itself (not
    # anything this process's caller writes) -- modeled here with a marker
    # file scoped to this cwd, so a later probe_session invocation in the
    # same directory (e.g. this same test's own second refresh) skips
    # straight to chat mode exactly like a real already-trusted directory
    # would.
    trust_marker = Path(os.getcwd()) / ".fake-claude-trust-accepted"
    buf = b""
    try:
        if not trust_marker.exists():
            got = b""
            while len(got) < len(TRUST_DIALOG_ACCEPT):
                b = os.read(0, 1)
                if not b:
                    return
                got += b
            if got != TRUST_DIALOG_ACCEPT:
                return  # the default "No, exit" was effectively selected
            trust_marker.write_text("trusted")
            # Recorded into the same per-invocation log a real submitted
            # chat line goes into (see below) -- so a test can see, in
            # order, exactly what raw input every attempt actually
            # consumed: trust-dialog bytes on a first-contact attempt,
            # real prompt text on a later, already-trusted one.
            with (root / "submitted_lines.log").open("a") as f:
                f.write(got.hex() + "\n")

            # session_conflict_after_trust.txt models Issue #19's
            # TrustAccepted race: a session conflict that only becomes
            # observable AFTER this invocation has just accepted the
            # workspace-trust dialog (by which point agentsctl's own Go
            # side has already durably persisted TrustAccepted:true --
            # see markTrustAccepted's doc comment, called unconditionally
            # right after the trust-dialog write succeeds, before this
            # invocation ever gets to process a real prompt line) -- as
            # opposed to session_conflict.txt/session_conflict_session_ids.txt
            # above, which model a conflict observable immediately on
            # startup, before any trust interaction at all. Exercises
            # that rotateProbeIdentity must carry forward the trust state
            # actually persisted during THIS attempt, not whatever the
            # caller's own in-memory identity copy looked like before the
            # attempt started.
            after_trust_conflict_path = root / "session_conflict_after_trust.txt"
            if after_trust_conflict_path.exists():
                os.write(1, after_trust_conflict_path.read_bytes())
                termios.tcsetattr(0, termios.TCSADRAIN, old)
                sys.exit(1)

        os.write(1, b"FAKE CLAUDE PROBE ATTACHED\r\n")
        while True:
            b = os.read(0, 1)
            if not b:
                break
            if b == b"\x1a":
                continue  # suspend request, not an exit -- see above
            buf += b
            if b in (b"\r", b"\n"):
                # first_submitted_line.bin records the raw bytes of the
                # first ever submitted line, across however many
                # probe_session invocations one test drives (only the
                # first write sticks): usage_probe_unix_test.go's
                # session-conflict-recovery test uses this to directly
                # assert that a post-rotation retry into an
                # already-trusted composer (trust_marker already exists,
                # so the trust-dialog-accept wait above never ran) never
                # receives the blind TRUST_DIALOG_ACCEPT keystroke
                # sequence -- proving the real prompt was sent, not just
                # that some usage reading eventually came back (which
                # this fake CLI's own leniency -- treating any submitted
                # line as a valid chat turn -- would not otherwise catch).
                first_line_path = root / "first_submitted_line.bin"
                if not first_line_path.exists():
                    first_line_path.write_bytes(buf)
                # submitted_lines.log is first_submitted_line.bin's per-
                # invocation counterpart: one hex-encoded line appended
                # per submitted line, across every probe_session
                # invocation in a test (not just the very first) -- so a
                # test can inspect a SPECIFIC attempt's submission (e.g.
                # "what did attempt #2, after rotation, actually send")
                # rather than only ever the first one that ever happened.
                with (root / "submitted_lines.log").open("a") as f:
                    f.write(buf.hex() + "\n")
                # limit_banner.txt (usage_probe_unix_test.go's limit-
                # detection fixtures) stands in for the real CLI hitting a
                # 5h/weekly usage limit: verified against the installed
                # CLI (2.1.263) that a probe process which never gets a
                # completed API response for its own prompt keeps
                # reporting total_api_duration_ms: 0 (no rate_limits
                # update) on every statusLine tick -- modeled here by
                # writing the fixture's banner text to the pty instead of
                # invoking statusLine at all for this line, so
                # classifyProbeOutput has real terminal output to work
                # from and waitForProbeOutcome never sees a
                # ResponseObserved snapshot for this refresh.
                banner_path = root / "limit_banner.txt"
                if banner_path.exists():
                    os.write(1, banner_path.read_bytes())
                else:
                    run_statusline()
                buf = b""
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, old)

def run_statusline():
    settings_path = root / "probe-settings.json"
    if not settings_path.exists():
        return
    settings = json.loads(settings_path.read_text())
    command = settings.get("statusLine", {}).get("command")
    if not command:
        return
    ratelimits_path = root / "ratelimits.json"
    # A real completed API turn (verified against the installed CLI,
    # 2.1.263): cost.total_api_duration_ms is non-zero once this process's
    # own prompt has gotten a response -- see parseStatusLinePayload's doc
    # comment and waitForProbeOutcome's ResponseObserved gate. This fake
    # only ever calls run_statusline in response to a submitted line (see
    # above), so it always represents a completed turn.
    payload = {"session_id": "probe", "cost": {"total_api_duration_ms": 1234}}
    if ratelimits_path.exists():
        payload["rate_limits"] = json.loads(ratelimits_path.read_text())
    subprocess.run(command, shell=True, input=json.dumps(payload).encode(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

args = sys.argv[1:]

if args[:1] == ["agents"]:
    print(json.dumps(load()))
elif args[:1] == ["--bg"]:
    rows = load(); sid = "claude-new"
    rows = [r for r in rows if r["id"] != sid]
    rows.append({"id":sid,"name":"fake-claude-new","summary":args[1],"cwd":os.getcwd(),"updatedAt":2,"status":"busy","state":"working"})
    save(rows); print(sid)
elif args[:1] == ["stop"]:
    rows = load()
    for row in rows:
        if row["id"] == args[1]: row["status"] = "idle"; row["state"] = "stopped"
    save(rows)
elif args[:1] == ["attach"]:
    old = termios.tcgetattr(0); tty.setraw(0)
    try:
        os.write(1, b"FAKE CLAUDE ATTACHED\r\n")
        while True:
            b = os.read(0, 1)
            if not b or b == b"\x1a": break
            os.write(1, b)
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, old)
elif "--session-id" in args or "--resume" in args:
    session_id = arg_value(args, "--session-id") or arg_value(args, "--resume")
    probe_session(session_id, arg_value(args, "--settings"))
else:
    sys.exit(2)
