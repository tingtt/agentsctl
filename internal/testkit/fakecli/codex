#!/usr/bin/env python3
import json, os, sys
from pathlib import Path

root = Path(os.environ["AGENTSCTL_FAKE_DIR"])
home = root / "codex-home"
home.mkdir(parents=True, exist_ok=True)
catalog = root / "codex.json"

def load():
    if not catalog.exists():
        return [{"id":"codex-ready","name":"fake-codex","preview":"Ready","cwd":os.getcwd(),"createdAt":1,"updatedAt":1,"status":{"type":"idle"},"archived":False}]
    return json.loads(catalog.read_text())

def save(rows):
    tmp = catalog.with_suffix(".tmp"); tmp.write_text(json.dumps(rows)); tmp.replace(catalog)

def rpc():
    for line in sys.stdin:
        try: req = json.loads(line)
        except Exception: continue
        if "id" not in req: continue
        method = req.get("method"); params = req.get("params") or {}; result = {}
        if method == "initialize": result = {"codexHome":str(home),"userAgent":"fake-codex"}
        elif method == "thread/list":
            archived = bool(params.get("archived", False))
            rows = [r for r in load() if bool(r.get("archived")) == archived]
            limit = int(params.get("limit") or len(rows) or 1)
            cursor = params.get("cursor")
            start = int(cursor) if cursor else 0
            page = rows[start:start+limit]
            next_cursor = str(start+limit) if start+limit < len(rows) else None
            result = {"data":page,"nextCursor":next_cursor}
        elif method == "account/rateLimits/read":
            rl_path = root / "ratelimits.json"
            if rl_path.exists():
                result = json.loads(rl_path.read_text())
            else:
                result = {"rateLimits": {"primary": {"usedPercent": 0, "resetsAt": None}, "secondary": {"usedPercent": 0, "resetsAt": None}}}
        elif method in ("thread/archive","thread/unarchive","thread/name/set"):
            rows = load()
            for row in rows:
                if row["id"] == params.get("threadId"):
                    if method == "thread/archive": row["archived"] = True
                    elif method == "thread/unarchive": row["archived"] = False
                    else:
                        row["name"] = params.get("name")
                        with (root / "rename.log").open("a") as log:
                            log.write(json.dumps({"id":row["id"],"name":row["name"]}) + "\n")
            save(rows)
        else:
            print(json.dumps({"jsonrpc":"2.0","id":req["id"],"error":{"code":-32601,"message":"not found"}}), flush=True); continue
        print(json.dumps({"jsonrpc":"2.0","id":req["id"],"result":result}), flush=True)

args = sys.argv[1:]
if args[:2] == ["app-server","--stdio"]: rpc()
else: sys.exit(2)
